<%- include('partials/head') %>
<main class="container page page-narrow">
  <a class="back" href="/projects/<%= project.id %>">← <%= project.name %></a>
  <h1>Edit task</h1>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

  <div class="card">
    <form method="post" action="/tasks/<%= task.id %>" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Title <input name="title" required maxlength="200" value="<%= task.title %>"></label>
      <label>Description
        <textarea name="description" rows="4" maxlength="2000"><%= task.description %></textarea>
      </label>
      <div class="form-row">
        <label>Status
          <select name="status">
            <% for (const s of ['todo', 'doing', 'done']) { %>
              <option value="<%= s %>" <%= task.status === s ? 'selected' : '' %>><%= labels.status[s] %></option>
            <% } %>
          </select>
        </label>
        <label>Priority
          <select name="priority">
            <% for (const p of ['low', 'medium', 'high']) { %>
              <option value="<%= p %>" <%= task.priority === p ? 'selected' : '' %>><%= labels.priority[p] %></option>
            <% } %>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label>Assignee
          <select name="assignee_id">
            <option value="">Unassigned</option>
            <% for (const m of members) { %>
              <option value="<%= m.id %>" <%= String(task.assignee_id) === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
            <% } %>
          </select>
        </label>
        <label>Due date <input name="due_date" type="date" value="<%= task.due_date || '' %>"></label>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save task</button>
        <a class="btn btn-ghost" href="/projects/<%= project.id %>">Cancel</a>
      </div>
    </form>
  </div>

  <form method="post" action="/tasks/<%= task.id %>/delete" class="danger-zone" data-confirm="Delete this task? This cannot be undone.">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn btn-danger btn-sm" type="submit">Delete task</button>
  </form>
</main>
<%- include('partials/foot') %>
