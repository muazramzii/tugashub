<%- include('partials/head') %>
<main class="page page-narrow">
  <h1>Settings</h1>

  <section class="card">
    <h2>Profile</h2>
    <form method="post" action="/settings/profile" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Name <input name="name" required maxlength="80" value="<%= user.name %>"></label>
      <label>Email <input value="<%= user.email %>" disabled></label>
      <button class="btn btn-primary btn-sm" type="submit">Save profile</button>
    </form>
  </section>

  <% if (can.renameWorkspace(user)) { %>
  <section class="card">
    <h2>Workspace</h2>
    <form method="post" action="/settings/workspace" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Workspace name <input name="name" required maxlength="80" value="<%= workspace.name %>"></label>
      <button class="btn btn-primary btn-sm" type="submit">Rename workspace</button>
    </form>
  </section>
  <% } %>

  <section class="card" id="labels">
    <h2>Labels</h2>
    <p class="muted small">Labels group tasks across projects, like "Bug" or "Design". Filter by them on boards and in search.</p>
    <% if (labels.length) { %>
    <ul class="label-admin">
      <% for (const l of labels) { %>
      <li>
        <span class="label" style="--label: <%= l.color %>"><%= l.name %></span>
        <a class="small muted" href="/tasks?label=<%= l.id %>"><%= l.uses %> task<%= l.uses === 1 ? '' : 's' %></a>
        <% if (can.manageLabels(user)) { %>
        <form method="post" action="/settings/labels/<%= l.id %>/delete" data-confirm="Delete the label <%= l.name %>? It will be removed from <%= l.uses %> task(s).">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="icon-btn icon-btn-sm" type="submit" aria-label="Delete label <%= l.name %>"><%- icon('x', 14) %></button>
        </form>
        <% } %>
      </li>
      <% } %>
    </ul>
    <% } %>
    <% if (can.manageLabels(user)) { %>
    <form method="post" action="/settings/labels" class="stack label-new">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>New label <input name="name" required maxlength="30" placeholder="e.g. Urgent"></label>
      <%- include('partials/swatches', { colors: labelColors, selected: labelColors[0], name: 'color' }) %>
      <button class="btn btn-ghost btn-sm" type="submit">Add label</button>
    </form>
    <% } else { %>
      <p class="small muted">Only admins and the owner can add or delete labels.</p>
    <% } %>
  </section>

  <section class="card">
    <h2>Change password</h2>
    <form method="post" action="/settings/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Current password <input name="current" type="password" required autocomplete="current-password"></label>
      <label>New password <input name="next" type="password" required minlength="8" autocomplete="new-password">
        <span class="hint">At least 8 characters.</span>
      </label>
      <button class="btn btn-primary btn-sm" type="submit">Change password</button>
    </form>
  </section>
</main>
<%- include('partials/foot') %>
